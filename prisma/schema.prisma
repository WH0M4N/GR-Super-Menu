generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Food {
  id            Int     @id @default(autoincrement())
  title         String
  desc          String?
  image         String?
  category      String
  isWeeklyOffer Boolean @default(false)
  baseTaste     String?
  price         Float
}

model Game {
  id            Int     @id @default(autoincrement())
  title         String
  desc          String?
  image         String?
  genre         String
  playerCount   String
  isWeeklyOffer Boolean @default(false)
}

model AdminUser {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}